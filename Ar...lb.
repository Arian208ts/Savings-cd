void One_Dimensional_Int_Array_Input(int aa[50], int nn)

{
    printf("\nEnter %d values \n", nn);
    for(int i=1 ; i<=nn ; i++)
    {
        scanf("%d", &aa[i]);
    }
}

void One_Dimensional_Int_Array_Display(int aa[50], int nn)
{
    printf("\nThe values are : \n", nn);
    for(int i=1 ; i<=nn ; i++)
    {
        printf("%d ", aa[i]);
    }
}
int OneDIntArrayInput_LP(int aa[50], int nn, int vv)
{
    aa[nn+1] = vv;
    return nn+1;
}

int OneDIntArrayInput_SP(int aa[50], int nn, int vv, int pp)
{
    for(int i=nn ; i>=pp ; i--)
    {
        aa[i+1] = aa[i];
    }
    aa[pp] = vv;
    return nn+1;
}

int OneDIntArrayDel_SP(int aa[50], int nn, int pp)
{   int i;
    for(i=pp ; i<nn ; i++)
    {
        aa[i] = aa[i+1];
    }
    return nn-1;
}

void OneDIntArrayLinearsearch(int aa[50], int nn, int vv)
{
    int c=0;
    for(int i=1 ; i<=nn ; i++)
    {
        if(vv == aa[i])
        {
            printf("\nFound at position = %d\n", i);
            c = c+1;
        }
    }
    if(c == 0)
    {
        printf("\nNot Found\n");
    }
    else{
        printf("\nTotal Found = %d\n", c);
    }
}
void OneDIntArray_BubbleSort(int aa[50], int nn)
{
    for(int i=1 ; i<=nn ; i++)
    {
        for(int j=1 ; j<=nn-i ; j++)
        {
            if(aa[j] > aa[j+1])
            {
                int temp = aa[j];
                aa[j] = aa[j+1];
                aa[j+1] = temp;
            }
        }
    }
}

void OneDIntArray_BinarySearch(int aa[50], int nn, int vv)
{
    int begin, end, mid;
    OneDIntArray_BubbleSort(aa, nn);
    begin = 1, end = nn;
    do
    {
        mid = (begin + end) / 2;
        if(vv < aa[mid])
        {
            end = mid - 1;
        }
        else if(vv > aa[mid])
        {
            begin = mid + 1;
        }
    } while(begin <= end && vv != aa[mid]);
    if(vv == aa[mid])
    {
        printf("\nFound\n");
    }
    else
    {
        printf("\nNot Found\n");
    }
}

